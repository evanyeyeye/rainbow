__pycache__/
docs/_build/*
docs/_autosummary/*

.DS_STORE

# editor / agent tooling state (never part of the package)
.claude/

# local docs build environment
.venv-docs/

# build artifacts
*.egg-info/
build/
dist/
*.so
# Cython-generated C source (regenerated at build time)
rainbow/agilent/_uvdelta.c
rainbow/agilent/_msprofile.c
rainbow/agilent/_chdelta.c

# working notes, not part of the package
/asm-notes/
/asm-reference/

# Local datasets and anything derived from them. Keep them here, under a path
# this file already covers, rather than adding a new entry per dataset: a
# per-dataset line is a poor guard (it protects only what someone remembered to
# list) and the entry outlives the data. Anything outside these paths is not
# ignored, so check `git status` before committing.
/data/
/datasets/
# exported ASM documents (never commit; these come from real samples)
/ASMs/
